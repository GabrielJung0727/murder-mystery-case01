{
  "name": "gongjakso-night",
  "productName": "공작소 도서관",
  "version": "3.0.1",
  "description": "MURDER MYSTERY CASE 01 - 공작소의 밤 (PC 2D 추리 게임)",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "server": "esbuild scripts/server.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs && node dist-server/server.cjs",
    "blip-script": "esbuild scripts/gen_blip_script.ts --bundle --platform=node --format=esm --outfile=dist-server/gen_blip.mjs && node dist-server/gen_blip.mjs",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --external:electron --external:electron-updater",
    "build": "npm run licenses && tsc --noEmit && vite build && npm run build:main",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "licenses": "node scripts/gen_licenses.mjs",
    "e2e:online": "esbuild scripts/online_e2e.ts --bundle --platform=node --format=cjs --outfile=dist-server/online_e2e.cjs --log-level=warning && node dist-server/online_e2e.cjs",
    "build:cloud": "esbuild scripts/cloud_server.ts --bundle --platform=node --format=cjs --outfile=dist-server/cloud.cjs",
    "start:cloud": "node dist-server/cloud.cjs"
  },
  "dependencies": {
    "@fontsource/nanum-brush-script": "5.3.0",
    "@fontsource/nanum-gothic-coding": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fontsource/nanum-pen-script": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "electron-updater": "^6.3.9",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "ffmpeg-static": "5.2.0",
    "rcedit": "^4.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "wait-on": "8.0.1"
  },
  "build": {
    "appId": "com.gongjakso.night",
    "productName": "공작소 도서관",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "공작소 도서관",
      "uninstallDisplayName": "공작소 도서관",
      "deleteAppDataOnUninstall": false,
      "artifactName": "GongjaksoNight-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GabrielJung0727",
        "repo": "murder-mystery-case01",
        "releaseType": "release"
      }
    ],
    "afterPack": "scripts/after_pack.cjs"
  }
}
